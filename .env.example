# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Configuration
API_BASE_URL=http://localhost:5177

# Environment
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development

# Authentication (Supabase Settings)
AUTH_AUTHORITY=https://your-project.supabase.co/auth/v1
AUTH_VALID_ISSUER=https://your-project.supabase.co/auth/v1
AUTH_VALID_AUDIENCE=authenticated